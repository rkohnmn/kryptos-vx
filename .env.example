# ─────────────────────────────────────────────────────────────────────────────
# KRYPTOS-VX Runtime Environment Configuration (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# Number of worker threads for the parallel SIMD scanner (0 = hardware_concurrency)
KRYPTOS_VX_THREADS=0

# Maximum token budget when packing repositories for AI / Vibe Coding (default: 128000)
KRYPTOS_VX_MAX_TOKENS=128000

# Enable strict secret redaction during context packing (1 = enabled, 0 = disabled)
KRYPTOS_VX_REDACT_SECRETS=1

# Color theme for interactive TUI ("cyberpunk", "nord", "high-contrast")
KRYPTOS_VX_THEME=cyberpunk
